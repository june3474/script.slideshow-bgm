<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.slideshow-bgm"
       name="Slideshow-BGM"
       version="0.1.0"
       provider-name="dks">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="addon.py"/>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_gb">Background music for image/video slideshows</summary>
    <description lang="en_gb">Plays background music for the duration of a Kodi slideshow. Music pauses automatically when a video clip in the slideshow plays and resumes at the following track once the clip ends, until the slideshow itself exits.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
